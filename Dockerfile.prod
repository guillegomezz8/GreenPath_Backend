FROM python:3.11-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    binutils \
    gdal-bin \
    libgdal-dev \
    libproj-dev \
    libgeos-dev \
    postgresql-client \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# Runtime stage
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils \
    gdal-bin \
    libgdal-dev \
    libproj-dev \
    libgeos-dev \
    postgresql-client \
    libpq-dev \
    libgl1 \
    libglib2.0-0 \
    libcairo2 \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz-subset0 \
    libgdk-pixbuf-2.0-0 \
    shared-mime-info \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY --from=builder /root/.local /root/.local
ENV PATH=/root/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

RUN python -c "from weasyprint import HTML; HTML(string='<p>GreenPath PDF</p>').write_pdf('/tmp/weasyprint-smoke.pdf')" \
    && rm /tmp/weasyprint-smoke.pdf

COPY . .

RUN mkdir -p /src/media/exports \
    && mkdir -p /src/deploy/initial-exports \
    && cp /src/exports/greenpath_export_20260917_142638.json /src/deploy/initial-exports/ \
    && rm -rf /src/exports \
    && ln -s /src/media/exports /src/exports \
    && chmod +x ./docker-entrypoint.sh ./deploy/*.sh

ENTRYPOINT ["sh", "./docker-entrypoint.sh"]
CMD ["sh", "./deploy/start-api.sh"]
